# local.rules
# Custom Snort rules for the home network security lab.
# Tuned to detect port scans, brute-force attempts, and abnormal payloads
# generated by scripted attack simulations (see nmap/scan_hosts.py).

# --- Port scan detection ---
alert tcp any any -> $HOME_NET any (msg:"LAB Possible Nmap SYN scan"; \
    flags:S; threshold:type both, track by_src, count 20, seconds 5; \
    classtype:attempted-recon; sid:1000001; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"LAB Nmap version/OS detection probe"; \
    content:"Nmap"; nocase; classtype:attempted-recon; sid:1000002; rev:1;)

# --- Brute-force detection ---
alert tcp any any -> $HOME_NET 22 (msg:"LAB Possible SSH brute force"; \
    flags:S; threshold:type both, track by_src, count 10, seconds 30; \
    classtype:attempted-admin; sid:1000010; rev:1;)

alert tcp any any -> $HOME_NET 3389 (msg:"LAB Possible RDP brute force"; \
    flags:S; threshold:type both, track by_src, count 10, seconds 30; \
    classtype:attempted-admin; sid:1000011; rev:1;)

alert tcp any any -> $HOME_NET 21 (msg:"LAB Possible FTP brute force"; \
    flags:S; threshold:type both, track by_src, count 10, seconds 30; \
    classtype:attempted-admin; sid:1000012; rev:1;)

# --- Abnormal payload signatures ---
alert tcp any any -> $HOME_NET any (msg:"LAB Suspicious oversized payload"; \
    dsize:>1400; classtype:bad-unknown; sid:1000020; rev:1;)

alert udp any any -> $HOME_NET any (msg:"LAB Unexpected UDP flood"; \
    threshold:type both, track by_src, count 50, seconds 5; \
    classtype:attempted-dos; sid:1000021; rev:1;)
